# Copy to .env and fill in your key. Never commit the real .env.

# Nebius AI Studio API key (https://studio.nebius.com/) — the default provider.
NEBIUS_API_KEY=your_nebius_api_key_here

# Optional overrides — any OpenAI-compatible endpoint works.
# LLM_BASE_URL=https://api.studio.nebius.com/v1/
# LLM_MODEL=meta-llama/Meta-Llama-3.3-70B-Instruct
# To use OpenAI instead: set OPENAI_API_KEY, LLM_BASE_URL=https://api.openai.com/v1/, LLM_MODEL=gpt-4o-mini
